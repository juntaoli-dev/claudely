{
    "name": "claudely",
    "productName": "Claudely",
    "version": "0.1.0",
    "description": "Repo-aware meeting assistant powered by Claude",
    "main": "src/index.js",
    "scripts": {
        "setup": "npm install && cd web && npm install && npm run build && cd .. && npm start",
        "start": "npm run build:renderer && electron .",
        "package": "npm run build:all && electron-builder --dir",
        "make": "npm run build:renderer && electron-forge make",
        "build": "npm run build:all && electron-builder --config electron-builder.yml --publish never",
        "build:win": "npm run build:all && electron-builder --win --x64 --publish never",
        "publish": "npm run build:all && electron-builder --config electron-builder.yml --publish always",
        "lint": "eslint --ext .ts,.tsx,.js .",
        "postinstall": "electron-builder install-app-deps",
        "build:renderer": "node build.js",
        "build:web": "cd web && npm run build && cd ..",
        "build:native": "cd native/audio-capture && swiftc -parse-as-library -O -target arm64-apple-macosx14.0 -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker Info.plist Sources/audio-capture/main.swift -o .build/release/audio-capture",
        "build:all": "npm run build:native && npm run build:renderer && npm run build:web",
        "watch:renderer": "node build.js --watch",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "keywords": [
        "claudely",
        "claude",
        "meeting",
        "assistant"
    ],
    "author": {
        "name": "Juntao Li"
    },
    "license": "GPL-3.0",
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "^0.2.118",
        "@anthropic-ai/sdk": "^0.56.0",
        "@deepgram/sdk": "^4.9.1",
        "axios": "^1.10.0",
        "better-sqlite3": "^12.2.0",
        "cors": "^2.8.5",
        "dotenv": "^17.0.0",
        "electron-squirrel-startup": "^1.0.1",
        "electron-store": "^8.2.0",
        "electron-updater": "^6.6.2",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.2",
        "keytar": "^7.9.0",
        "node-fetch": "^2.7.0",
        "react-hot-toast": "^2.5.2",
        "sharp": "^0.34.2",
        "validator": "^13.11.0",
        "wait-on": "^8.0.3",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@electron/fuses": "^1.8.0",
        "@electron/notarize": "^2.5.0",
        "electron": "^30.5.1",
        "electron-builder": "^26.0.12",
        "electron-reloader": "^1.2.3",
        "esbuild": "^0.25.5",
        "prettier": "^3.6.2",
        "vitest": "^4.1.5"
    },
    "optionalDependencies": {
        "electron-liquid-glass": "^1.0.1"
    }
}
